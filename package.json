{
  "name": "crypto-research-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm unit && pnpm lint && pnpm typecheck && pnpm contract:check",
    "unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "contract:types": "openapi-typescript contract/openapi.json -o src/contract/api.d.ts",
    "contract:check": "node scripts/check-contract.mjs",
    "contract:pull": "node scripts/pull-contract.mjs",
    "live:check": "node scripts/check-live-fixture.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/cache": "11.13.5",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@mui/material": "5.16.14",
    "@mui/material-nextjs": "5.16.14",
    "next": "14.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sass": "1.90.0",
    "swr": "2.3.6"
  },
  "devDependencies": {
    "@types/node": "22.17.2",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.3",
    "husky": "9.1.7",
    "hygen": "6.2.11",
    "lint-staged": "16.1.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.28.1"
}
